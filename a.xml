                                    args: [],
                                }).then(function (result) {
                                    self.widget_data = result;
                                });
                            },
                            
                            _renderCharts: function () {
                                // Render sync trend chart
                                if (this.widget_data.sync_chart) {
                                    this._renderChart('syncChart', this.widget_data.sync_chart);
                                }
                                
                                // Render performance chart
                                if (this.widget_data.performance_chart) {
