                                        <div class="card-body">
                                            <h3 t-esc="len(doc.account_mapping_ids)"/>
                                            <p class="text-muted">Account Mappings</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 t-esc="len(doc.journal_mapping_ids)"/>
                                            <p class="text-muted">Journal Mappings</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Sync History -->
                        <div class="sync-history mb-4">
                            <h4>Recent Sync History (Last 10)</h4>
                            <table class="table table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>Sync Engine</th>
                                        <th>Status</th>
                                        <th>Moves</th>
                                        <th>Lines</th>
                                        <th>Duration</th>
                                        <th>Success Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="recent_logs" t-value="doc.sync_log_ids.filtered(lambda l: l.log_type == 'sync').sorted(key=lambda r: r.create_date, reverse=True)[:10]"/>
                                    <t t-foreach="recent_logs" t-as="log">
                                        <tr>
                                            <td t-esc="log.create_date.strftime('%Y-%m-%d')"/>
                                            <td t-esc="log.sync_engine_id.name if log.sync_engine_id else 'System'"/>
                                            <td>
                                                <span t-att-class="{
                                                    'badge badge-success': log.state == 'completed',
                                                    'badge badge-danger': log.state == 'error',
                                                    'badge badge-warning': log.state == 'cancelled'
                                                }">
                                                    <t t-esc="log.state"/>
                                                </span>
                                            </td>
                                            <td t-esc="log.records_processed"/>
                                            <td>
                                                <t t-esc="log.details and 'Lines: ' + log.details.split('Lines: ')[1].split(',')[0] if 'Lines: ' in (log.details or '') else 'N/A'"/>
                                            </td>
                                            <td t-esc="'{:.1f}s'.format(log.duration)"/>
                                            <td>
                                                <t t-esc="'100%' if log.state == 'completed' else '0%'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Mapping Coverage -->
                        <div class="mapping-coverage mb-4">
                            <h4>Mapping Coverage</h4>
                            <div class="row">
                                <div class="col-6">
                                    <h5>Account Mappings</h5>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Status</th>
                                                <th>Count</th>
                                                <th>Percentage</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="validated_mappings" t-value="doc.account_mapping_ids.filtered(lambda m: m.is_validated)"/>
                                            <t t-set="active_mappings" t-value="doc.account_mapping_ids.filtered(lambda m: m.active)"/>
                                            <tr>
                                                <td>Validated</td>
                                                <td t-esc="len(validated_mappings)"/>
                                                <td>
                                                    <t t-esc="'{:.1f}%'.format(len(validated_mappings) / len(doc.account_mapping_ids) * 100 if doc.account_mapping_ids else 0)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Active</td>
                                                <td t-esc="len(active_mappings)"/>
                                                <td>
                                                    <t t-esc="'{:.1f}%'.format(len(active_mappings) / len(doc.account_mapping_ids) * 100 if doc.account_mapping_ids else 0)"/>
                                                </td>
                                            </tr>
                                            <tr class="table-primary">
                                                <td><strong>Total</strong></td>
                                                <td><strong t-esc="len(doc.account_mapping_ids)"/></td>
                                                <td><strong>100%</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <h5>Journal Mappings</h5>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Status</th>
                                                <th>Count</th>
                                                <th>Percentage</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="validated_journals" t-value="doc.journal_mapping_ids.filtered(lambda m: m.is_validated)"/>
                                            <t t-set="active_journals" t-value="doc.journal_mapping_ids.filtered(lambda m: m.active)"/>
                                            <tr>
                                                <td>Validated</td>
                                                <td t-esc="len(validated_journals)"/>
                                                <td>
                                                    <t t-esc="'{:.1f}%'.format(len(validated_journals) / len(doc.journal_mapping_ids) * 100 if doc.journal_mapping_ids else 0)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Active</td>
                                                <td t-esc="len(active_journals)"/>
                                                <td>
                                                    <t t-esc="'{:.1f}%'.format(len(active_journals) / len(doc.journal_mapping_ids) * 100 if doc.journal_mapping_ids else 0)"/>
                                                </td>
                                            </tr>
                                            <tr class="table-primary">
                                                <td><strong>Total</strong></td>
                                                <td><strong t-esc="len(doc.journal_mapping_ids)"/></td>
                                                <td><strong>100%</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Error Analysis -->
                        <t t-set="error_logs" t-value="doc.sync_log_ids.filtered(lambda l: l.state == 'error')"/>
                        <t t-if="error_logs">
                            <div class="error-analysis mb-4">
                                <h4>Error Analysis (Top 5 Error Types)</h4>
                                <table class="table table-bordered">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Error Type</th>
                                            <th>Count</th>
                                            <th>Last Occurrence</th>
                                            <th>Severity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="error_counts" t-value="{}"/>
                                        <t t-foreach="error_logs" t-as="log">
                                            <t t-set="error_type" t-value="log.log_type"/>
                                            <t t-if="error_type not in error_counts">
                                                <t t-set="error_counts" t-value="error_counts.update({error_type: {'count': 0, 'last_date': log.create_date, 'severity': log.severity}})"/>
                                            </t>
                                            <t t-set="error_counts[error_type]['count']" t-value="error_counts[error_type]['count'] + 1"/>
                                            <t t-if="log.create_date > error_counts[error_type]['last_date']">
                                                <t t-set="error_counts[error_type]['last_date']" t-value="log.create_date"/>
                                            </t>
                                        </t>
                                        <t t-foreach="sorted(error_counts.items(), key=lambda x: x[1]['count'], reverse=True)[:5]" t-as="error">
                                            <tr>
                                                <td t-esc="error[0].title()"/>
                                                <td t-esc="error[1]['count']"/>
                                                <td t-esc="error[1]['last_date'].strftime('%Y-%m-%d')"/>
                                                <td>
                                                    <span t-att-class="{
                                                        'badge badge-danger': error[1]['severity'] == 'critical',
                                                        'badge badge-warning': error[1]['severity'] == 'high',
                                                        'badge badge-info': error[1]['severity'] == 'medium',
                                                        'badge badge-secondary': error[1]['severity'] == 'low'
                                                    }">
                                                        <t t-esc="error[1]['severity']"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        
                        <!-- Recommendations -->
                        <div class="recommendations">
                            <h4>Recommendations</h4>
                            <div class="card">
                                <div class="card-body">
                                    <t t-if="doc.success_rate &lt; 80">
                                        <p class="text-danger">
                                            <i class="fa fa-exclamation-triangle"></i>
                                            Success rate is below 80%. Review connection settings and error logs.
                                        </p>
                                    </t>
                                    <t t-if="len(validated_mappings) / len(doc.account_mapping_ids) * 100 &lt; 90">
                                        <p class="text-warning">
                                            <i class="fa fa-check-circle"></i>
                                            Only <t t-esc="'{:.1f}%'.format(len(validated_mappings) / len(doc.account_mapping_ids) * 100)"/> of account mappings are validated.
                                        </p>
                                    </t>
                                    <t t-if="doc.state == 'error'">
                                        <p class="text-danger">
                                            <i class="fa fa-exclamation-circle"></i>
                                            Subsidiary connection is in error state. Validate connection.
                                        </p>
                                    </t>
                                    <t t-if="doc.last_sync_date and (datetime.datetime.now() - doc.last_sync_date).days > 7">
                                        <p class="text-info">
                                            <i class="fa fa-clock-o"></i>
                                            Last sync was <t t-esc="(datetime.datetime.now() - doc.last_sync_date).days"/> days ago.
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div class="footer mt-5 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <p class="text-muted">
                                        Generated by Financial Consolidation Module v1.0
                                    </p>
                                </div>
                                <div class="col-6 text-right">
                                    <p class="text-muted">
                                        Page <span class="page"/> of <span class="topage"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
