                            </group>
                        </page>
                        <page name="notifications" string="Notification Settings">
                            <group name="notification_rules">
                                <field name="notify_on_sync_completion"/>
                                <field name="notify_on_sync_failure"/>
                                <field name="notify_on_sla_violation"/>
                                <field name="notification_email_template_id"/>
                            </group>
                        </page>
                        <page name="maintenance" string="Maintenance Settings">
                            <group name="maintenance_options">
                                <field name="auto_cleanup_old_data"/>
                                <field name="auto_generate_analytics"/>
                                <field name="enable_health_monitoring"/>
                            </group>
                        </page>
                        <page name="audit" string="Audit Settings">
                            <group name="audit_options">
                                <field name="enable_immutable_ledger"/>
                                <field name="require_audit_trail"/>
                                <field name="audit_retention_years"/>
