<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Consolidation Summary Report -->
        <record id="action_consolidation_reports" model="ir.actions.report">
            <field name="name">Consolidation Summary Report</field>
            <field name="model">sync.engine</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_consolidation.consolidation_summary_report</field>
            <field name="print_report_name">'Consolidation Summary - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_sync_engine"/>
            <field name="binding_type">report</field>
        </record>
        
        <!-- Consolidation Summary Report Template -->
        <template id="consolidation_summary_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <!-- Header -->
                        <div class="header">
                            <div class="row">
                                <div class="col-6">
                                    <h2>Financial Consolidation Summary</h2>
                                    <h4>Sync Engine: <span t-esc="doc.name"/></h4>
                                </div>
                                <div class="col-6 text-right">
                                    <h5>Company: <span t-esc="doc.company_id.name"/></h5>
                                    <p>Generated: <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/></p>
                                    <p>Period: <span t-esc="doc.date_from"/> to <span t-esc="doc.date_to"/></p>
                                </div>
                            </div>
                            <hr/>
                        </div>
                        
                        <!-- Executive Summary -->
                        <div class="executive-summary mb-4">
                            <h4>Executive Summary</h4>
                            <div class="row">
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 t-esc="doc.total_moves_fetched"/>
                                            <p class="text-muted">Moves Fetched</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 t-esc="doc.total_moves_promoted"/>
                                            <p class="text-muted">Moves Promoted</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3 t-esc="doc.subsidiaries_completed"/>
                                            <p class="text-muted">Subsidiaries</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h3>
                                                <t t-esc="'{:.2f}'.format(doc.duration / 60)"/>
                                            </h3>
                                            <p class="text-muted">Minutes</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Subsidiary Details -->
                        <div class="subsidiary-details mb-4">
                            <h4>Subsidiary Performance</h4>
                            <table class="table table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Subsidiary</th>
                                        <th>Status</th>
                                        <th>Moves</th>
                                        <th>Lines</th>
                                        <th>Success Rate</th>
                                        <th>Duration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.subsidiary_ids" t-as="subsidiary">
                                        <tr>
                                            <td t-esc="subsidiary.name"/>
                                            <td>
                                                <span t-att-class="{
                                                    'badge badge-success': subsidiary.state == 'validated',
                                                    'badge badge-danger': subsidiary.state == 'error',
                                                    'badge badge-warning': subsidiary.state == 'suspended'
                                                }">
                                                    <t t-esc="subsidiary.state"/>
                                                </span>
                                            </td>
                                            <td t-esc="len(subsidiary.media_move_ids.filtered(lambda m: m.sync_engine_id.id == doc.id))"/>
                                            <td>
                                                <t t-set="total_lines" t-value="0"/>
                                                <t t-foreach="subsidiary.media_move_ids.filtered(lambda m: m.sync_engine_id.id == doc.id)" t-as="move">
                                                    <t t-set="total_lines" t-value="total_lines + len(move.line_ids)"/>
                                                </t>
                                                <t t-esc="total_lines"/>
                                            </td>
                                            <td>
                                                <t t-esc="'{:.1f}%'.format(subsidiary.success_rate)"/>
                                            </td>
                                            <td>
                                                <t t-esc="'{:.1f} min'.format(subsidiary.avg_sync_duration / 60)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Media Moves Summary -->
                        <div class="media-moves-summary mb-4">
                            <h4>Media Moves Summary</h4>
                            <table class="table table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Status</th>
                                        <th>Count</th>
                                        <th>Percentage</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="states" t-value="['draft', 'validated', 'reconciled', 'promoted', 'error', 'cancelled']"/>
                                    <t t-foreach="states" t-as="state">
                                        <t t-set="moves" t-value="doc.media_move_ids.filtered(lambda m: m.state == state)"/>
                                        <t t-set="total_amount" t-value="sum(moves.mapped('amount_total'))"/>
                                        <tr>
                                            <td t-esc="state.title()"/>
                                            <td t-esc="len(moves)"/>
                                            <td>
                                                <t t-esc="'{:.1f}%'.format(len(moves) / len(doc.media_move_ids) * 100 if doc.media_move_ids else 0)"/>
                                            </td>
                                            <td>
                                                <t t-esc="'${:,.2f}'.format(total_amount)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="table-primary">
                                        <td><strong>Total</strong></td>
                                        <td><strong t-esc="len(doc.media_move_ids)"/></td>
                                        <td><strong>100%</strong></td>
                                        <td>
                                            <strong>
                                                <t t-esc="'${:,.2f}'.format(sum(doc.media_move_ids.mapped('amount_total')))"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Error Analysis -->
                        <t t-set="error_logs" t-value="doc.consolidation_log_ids.filtered(lambda l: l.state == 'error')"/>
                        <t t-if="error_logs">
                            <div class="error-analysis mb-4">
                                <h4>Error Analysis</h4>
                                <div class="alert alert-warning">
                                    <h5>
                                        <i class="fa fa-exclamation-triangle"></i>
                                        <t t-esc="len(error_logs)"/> errors detected
                                    </h5>
                                </div>
                                <table class="table table-bordered">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Time</th>
                                            <th>Subsidiary</th>
                                            <th>Error Type</th>
                                            <th>Message</th>
                                            <th>Severity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="error_logs[:10]" t-as="log">
                                            <tr>
                                                <td t-esc="log.create_date.strftime('%H:%M')"/>
                                                <td t-esc="log.subsidiary_id.name if log.subsidiary_id else 'System'"/>
                                                <td t-esc="log.log_type"/>
                                                <td>
                                                    <small t-esc="log.message[:50] + '...' if len(log.message) > 50 else log.message"/>
                                                </td>
                                                <td>
                                                    <span t-att-class="{
                                                        'badge badge-danger': log.severity == 'critical',
                                                        'badge badge-warning': log.severity == 'high',
                                                        'badge badge-info': log.severity == 'medium',
                                                        'badge badge-secondary': log.severity == 'low'
                                                    }">
                                                        <t t-esc="log.severity"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        
                        <!-- Recommendations -->
                        <div class="recommendations">
                            <h4>Recommendations</h4>
                            <div class="card">
                                <div class="card-body">
                                    <t t-if="doc.state == 'completed'">
                                        <p class="text-success">
                                            <i class="fa fa-check-circle"></i>
                                            Sync completed successfully. All moves have been processed.
                                        </p>
                                    </t>
                                    <t t-if="doc.state == 'error'">
                                        <p class="text-danger">
                                            <i class="fa fa-exclamation-triangle"></i>
                                            Sync encountered errors. Review error logs and consider retry.
                                        </p>
                                    </t>
                                    <t t-if="len(doc.media_move_ids.filtered(lambda m: m.state == 'draft')) > 0">
                                        <p class="text-warning">
                                            <i class="fa fa-clock-o"></i>
                                            <t t-esc="len(doc.media_move_ids.filtered(lambda m: m.state == 'draft'))"/>
                                            moves are still in draft state and need validation.
                                        </p>
                                    </t>
                                    <t t-if="doc.total_moves_promoted &lt; doc.total_moves_fetched">
                                        <p class="text-info">
                                            <i class="fa fa-arrow-circle-up"></i>
                                            <t t-esc="doc.total_moves_fetched - doc.total_moves_promoted"/>
                                            moves are ready for promotion.
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div class="footer mt-5 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <p class="text-muted">
                                        Generated by Financial Consolidation Module v1.0
                                    </p>
                                </div>
                                <div class="col-6 text-right">
                                    <p class="text-muted">
                                        Page <span class="page"/> of <span class="topage"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
        
        <!-- Performance Analytics Report -->
        <record id="action_performance_analytics_report" model="ir.actions.report">
            <field name="name">Performance Analytics Report</field>
            <field name="model">consolidation.analytics</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_consolidation.performance_analytics_report</field>
            <field name="print_report_name">'Performance Analytics - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_consolidation_analytics"/>
