    <record id="view_consolidation_config_tree" model="ir.ui.view">
        <field name="name">consolidation.config.tree</field>
        <field name="model">consolidation.config</field>
        <field name="arch" type="xml">
            <tree string="Consolidation Configurations">
                <field name="company_id"/>
                <field name="default_batch_size"/>
                <field name="max_parallel_workers"/>
                <field name="strict_validation"/>
                <field name="enable_immutable_ledger"/>
            </tree>
        </field>
    </record>

    <!-- CONSOLIDATION LOG VIEWS -->
    <record id="view_consolidation_log_tree" model="ir.ui.view">
        <field name="name">consolidation.log.tree</field>
        <field name="model">consolidation.log</field>
        <field name="arch" type="xml">
            <tree string="Consolidation Logs" decoration-success="state == 'success'" 
                  decoration-warning="state == 'warning'" 
                  decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="log_type"/>
                <field name="message"/>
                <field name="subsidiary_id"/>
                <field name="state"/>
                <field name="duration"/>
                <field name="records_processed"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_consolidation_log_form" model="ir.ui.view">
        <field name="name">consolidation.log.form</field>
        <field name="model">consolidation.log</field>
        <field name="arch" type="xml">
            <form string="Consolidation Log">
                <sheet>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('state', '!=', 'error')]}">
                        Error Log Entry
                    </div>
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state', '!=', 'warning')]}">
                        Warning Log Entry
                    </div>
                    <group>
                        <group name="log_info">
                            <field name="log_type"/>
                            <field name="message" nolabel="1"/>
                            <field name="state"/>
                        </group>
                        <group name="context">
                            <field name="subsidiary_id"/>
                            <field name="sync_engine_id"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <group>
                        <group name="timing">
                            <field name="create_date" readonly="1"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration"/>
                        </group>
                        <group name="details">
                            <field name="records_processed"/>
                            <field name="related_model"/>
                            <field name="related_id"/>
                            <field name="checksum" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details">
                            <label for="details" string="Details"/>
                            <field name="details" nolabel="1"/>
                        </page>
                        <page name="metadata" string="Metadata">
                            <label for="metadata" string="Additional Metadata (JSON)"/>
                            <field name="metadata" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_consolidation_log_search" model="ir.ui.view">
        <field name="name">consolidation.log.search</field>
        <field name="model">consolidation.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="message"/>
                <field name="subsidiary_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_info" string="Information" domain="[('log_type', '=', 'info')]"/>
                <filter name="filter_warning" string="Warning" domain="[('log_type', '=', 'warning')]"/>
                <filter name="filter_error" string="Error" domain="[('log_type', '=', 'error')]"/>
                <filter name="filter_validation" string="Validation" domain="[('log_type', '=', 'validation')]"/>
                <filter name="filter_sync" string="Sync Operations" domain="[('log_type', '=', 'sync')]"/>
                <separator/>
                <filter name="filter_state_success" string="Success" domain="[('state', '=', 'success')]"/>
                <filter name="filter_state_error" string="Failed" domain="[('state', '=', 'error')]"/>
                <filter name="filter_state_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('create_date', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter name="filter_week" string="This Week" domain="[('create_date', '&gt;=', datetime.datetime.now() - datetime.timedelta(days=7))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_log_type" string="Log Type" context="{'group_by': 'log_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_subsidiary" string="Subsidiary" context="{'group_by': 'subsidiary_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- CONSOLIDATION ANALYTICS VIEWS -->
    <record id="view_consolidation_analytics_tree" model="ir.ui.view">
        <field name="name">consolidation.analytics.tree</field>
        <field name="model">consolidation.analytics</field>
        <field name="arch" type="xml">
            <tree string="Analytics">
                <field name="date"/>
                <field name="period_type"/>
                <field name="total_syncs"/>
                <field name="success_rate" widget="progressbar"/>
                <field name="system_health_score" widget="progressbar"/>
                <field name="total_moves_processed"/>
                <field name="avg_sync_duration"/>
            </tree>
        </field>
    </record>

    <record id="view_consolidation_analytics_form" model="ir.ui.view">
        <field name="name">consolidation.analytics.form</field>
        <field name="model">consolidation.analytics</field>
        <field name="arch" type="xml">
            <form string="Consolidation Analytics">
                <sheet>
                    <group string="Period Information">
                        <field name="name" readonly="1"/>
                        <field name="date" readonly="1"/>
                        <field name="period_type" readonly="1"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="sync_metrics" string="Sync Metrics">
                            <group>
                                <field name="total_syncs"/>
                                <field name="completed_syncs"/>
                                <field name="failed_syncs"/>
                                <field name="cancelled_syncs"/>
                                <field name="in_progress_syncs"/>
                            </group>
                            <group>
                                <field name="success_rate" widget="progressbar"/>
                                <field name="failure_rate" widget="progressbar"/>
                            </group>
                        </page>
                        <page name="subsidiary_metrics" string="Subsidiary Metrics">
                            <group>
                                <field name="total_subsidiaries"/>
                                <field name="synced_subsidiaries"/>
                                <field name="failed_subsidiaries"/>
                            </group>
                        </page>
                        <page name="volume_metrics" string="Volume Metrics">
                            <group>
                                <field name="total_moves_processed"/>
                                <field name="total_lines_processed"/>
                                <field name="total_moves_promoted"/>
                                <field name="avg_moves_per_sync"/>
                                <field name="avg_lines_per_move"/>
                            </group>
                        </page>
                        <page name="performance" string="Performance">
                            <group>
                                <field name="avg_sync_duration"/>
                                <field name="min_sync_duration"/>
                                <field name="max_sync_duration"/>
                                <field name="total_processing_time"/>
                                <field name="total_data_volume_mb"/>
                                <field name="avg_data_per_sync_mb"/>
                            </group>
                        </page>
                        <page name="mapping_stats" string="Mapping Statistics">
                            <group>
                                <field name="total_account_mappings"/>
                                <field name="validated_mappings"/>
                                <field name="unvalidated_mappings"/>
                                <field name="mapping_validation_rate" widget="progressbar"/>
                            </group>
                        </page>
                        <page name="error_analysis" string="Error Analysis">
                            <group>
                                <field name="total_errors"/>
                                <field name="unique_errors"/>
                                <field name="error_trend"/>
                            </group>
                        </page>
                        <page name="system_health" string="System Health">
                            <group>
                                <field name="system_health_score" widget="progressbar"/>
                                <field name="best_performing_subsidiary_id"/>
                                <field name="worst_performing_subsidiary_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_consolidation_analytics_search" model="ir.ui.view">
        <field name="name">consolidation.analytics.search</field>
        <field name="model">consolidation.analytics</field>
        <field name="arch" type="xml">
            <search string="Search Analytics">
                <field name="date"/>
                <field name="period_type"/>
                <separator/>
                <filter name="filter_daily" string="Daily" domain="[('period_type', '=', 'daily')]"/>
                <filter name="filter_weekly" string="Weekly" domain="[('period_type', '=', 'weekly')]"/>
                <filter name="filter_monthly" string="Monthly" domain="[('period_type', '=', 'monthly')]"/>
                <filter name="filter_quarterly" string="Quarterly" domain="[('period_type', '=', 'quarterly')]"/>
                <filter name="filter_yearly" string="Yearly" domain="[('period_type', '=', 'yearly')]"/>
                <separator/>
                <filter name="filter_healthy" string="Healthy" domain="[('system_health_score', '&gt;=', 90)]"/>
                <filter name="filter_warning" string="Warning" domain="[('system_health_score', '&lt;', 90), ('system_health_score', '&gt;=', 70)]"/>
                <filter name="filter_critical" string="Critical" domain="[('system_health_score', '&lt;', 70)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_period" string="Period Type" context="{'group_by': 'period_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
